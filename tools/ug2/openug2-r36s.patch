diff --git a/src/rhi_gl.c b/src/rhi_gl.c
index 7f90cec..f5164ee 100644
--- a/src/rhi_gl.c
+++ b/src/rhi_gl.c
@@ -531,6 +531,21 @@ RhiResult rhi_texture_upload(RhiTexture tex, int32_t face, int32_t level,
         glTexImage2D(target, level, (GLint)fmt, w, h, 0, fmt, GL_UNSIGNED_BYTE, data);
     }
     work_unit_done(active);
+    {   /* OPENUG2_TEXSTAT=1: running total of texture bytes handed to GL (stderr,
+           every 32 MB crossed) -- memory sizing for low-RAM targets. */
+        static int on = -1; static unsigned long long total, next = 32ull << 20;
+        if (on < 0) on = getenv("OPENUG2_TEXSTAT") ? 1 : 0;
+        if (on) {
+            unsigned bpp = t->format == RHI_FORMAT_RGB8 ? 3 : 4;
+            total += format_compressed(t->format) ? size : (unsigned long long)w * h * bpp;
+            if (total >= next) {
+                fprintf(stderr, "[texstat] %llu MB uploaded (last %dx%d level %d fmt %d)\n",
+                        total >> 20, (int)w, (int)h, (int)level, (int)t->format);
+                fflush(stderr);
+                next = (total | ((32ull << 20) - 1)) + 1;
+            }
+        }
+    }
